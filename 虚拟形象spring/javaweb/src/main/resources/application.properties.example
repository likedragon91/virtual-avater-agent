# 复制本文件为 application.properties 后启动；application.properties 已被 .gitignore 忽略
#
# ===== 环境变量约定 =====
# 必填：
#   DB_PASSWORD          MySQL 密码
#   JWT_SECRET           JWT 签名密钥，至少 32 字符，可用 openssl rand -base64 48 生成
# 建议配置：
#   DEEPSEEK_API_KEY     DeepSeek 密钥（不配置则对话功能不可用）
#   BOCHA_API_KEY        博查搜索密钥（不配置则 search_web 工具不启用）
#   MAIL_HOST / MAIL_USERNAME / MAIL_PASSWORD   SMTP 邮件服务（找回密码）
# 可选：
#   SERVER_PORT、DB_URL、DB_USERNAME、REDIS_HOST、REDIS_PORT、REDIS_DATABASE、REDIS_PASSWORD、
#   WEB_PUSH_PUBLIC_KEY、WEB_PUSH_PRIVATE_KEY、WEB_PUSH_SUBJECT

# 服务器配置
server.port=${SERVER_PORT:1107}

# 上传：静态图 20MB、Live2D 模型 zip 500MB；管理员桌面端安装包 300MB。
# 内存阈值保持 20MB：小于 20MB 的请求在内存处理，超过的模型/安装包由容器落盘。
spring.servlet.multipart.max-file-size=520MB
spring.servlet.multipart.max-request-size=540MB
spring.servlet.multipart.file-size-threshold=20MB

# 本地文件存储
app.upload.dir=${UPLOAD_DIR:./uploads}
app.upload.public-path=/api/files
app.upload.max-image-bytes=20971520
app.upload.max-model-bytes=524288000
app.upload.max-installer-bytes=314572800

# 数据库配置
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/%E8%99%9A%E6%8B%9F%E5%BD%A2%E8%B1%A1?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hikari 连接池（2C4G 起步配置，按实际并发调整）
spring.datasource.hikari.pool-name=AvatarHikariPool
spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX_SIZE:10}
spring.datasource.hikari.minimum-idle=${DB_POOL_MIN_IDLE:2}
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.leak-detection-threshold=60000

# Flyway：新库自动建表；已有库以 baseline-version=0 接管，然后补索引和种子
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.table=flyway_schema_history
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.baseline-description=baseline existing schema before Flyway
spring.flyway.validate-on-migrate=true
spring.flyway.clean-disabled=true
spring.flyway.out-of-order=false

# Redis 配置（JWT 白名单、验证码、在线会话）
spring.data.redis.host=${REDIS_HOST:127.0.0.1}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.database=${REDIS_DATABASE:0}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.timeout=3s

# 验证码配置（测试环境可设 CAPTCHA_ENABLED=false 跳过校验）
captcha.enabled=${CAPTCHA_ENABLED:true}
captcha.expire-seconds=300

# 在线用户配置（超过该分钟数没有请求视为离线）
online.timeout-minutes=30

# 邮件服务（找回密码验证码）
# QQ/163 邮箱通常使用 465 + SSL；Gmail 可用 587 + STARTTLS
spring.mail.host=${MAIL_HOST:}
spring.mail.port=${MAIL_PORT:465}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:true}
spring.mail.properties.mail.smtp.ssl.enable=${MAIL_SSL_ENABLED:true}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_STARTTLS_ENABLED:false}
mail.from=${MAIL_FROM:}

# 找回密码验证码策略
auth.reset.code-ttl-seconds=${RESET_CODE_TTL_SECONDS:600}
auth.reset.resend-cooldown-seconds=${RESET_RESEND_COOLDOWN_SECONDS:60}
auth.reset.max-attempts=${RESET_MAX_ATTEMPTS:5}

# JWT 配置（生产环境通过 JWT_SECRET 注入，不要在文件中写明文）
jwt.secret=${JWT_SECRET}
# 分环境 Token 策略（毫秒）：Electron 长会话，浏览器 / PWA 短会话
# 默认值已够用：Web Access 30 分钟 / Refresh 14 天；Desktop Access 1 小时 / Refresh 30 天
jwt.access-expiration-desktop=${JWT_ACCESS_EXPIRATION_DESKTOP:3600000}
jwt.access-expiration-web=${JWT_ACCESS_EXPIRATION_WEB:1800000}
jwt.refresh-expiration-desktop=${JWT_REFRESH_EXPIRATION_DESKTOP:2592000000}
jwt.refresh-expiration-web=${JWT_REFRESH_EXPIRATION_WEB:1209600000}
# 旧字段保留作为缺省回退
jwt.expiration=3600000
jwt.refresh-expiration=86400000
jwt.header=Authorization
jwt.token-prefix=Bearer

# DeepSeek 配置（密钥只从环境变量 DEEPSEEK_API_KEY 读取）
deepseek.base-url=https://api.deepseek.com
deepseek.api-key=${DEEPSEEK_API_KEY:}
deepseek.model=deepseek-chat
deepseek.max-tokens=4096
deepseek.temperature=0.8
deepseek.connect-timeout-ms=5000
deepseek.request-timeout-ms=120000
deepseek.max-retries=1
deepseek.include-usage=true

# 上下文代理（billion-context 边车）。未启动时按 fallback-to-direct 自动回退
deepseek.proxy-enabled=${DEEPSEEK_PROXY_ENABLED:true}
deepseek.proxy-url=${DEEPSEEK_PROXY_URL:http://127.0.0.1:8787/bili/https://api.deepseek.com}
deepseek.fallback-to-direct=${DEEPSEEK_FALLBACK_TO_DIRECT:true}
deepseek.proxy-timeout-ms=${DEEPSEEK_PROXY_TIMEOUT_MS:30000}

# Agent 会话配置
# 上下文预算：80000 字符 ≈ 10-12 万 tokens（中文实际密度约 1-1.3 token/字），
# 给系统提示与当前消息留出余量，适配 deepseek-chat 的 128K 窗口
agent.context.max-messages=200
agent.context.max-chars=80000
agent.tool.max-rounds=3
agent.tool.max-calls-per-round=5
agent.tool.timeout-ms=12000

# 记忆检索与上下文预算
agent.context.memory-top-k=6
agent.context.memory-max-chars=1200
agent.context.memory-item-max-chars=120
agent.context.memory-candidate-limit=20
agent.context.summary-max-chars=800
agent.context.summary-trigger-messages=12
agent.context.summary-max-tokens=400

# 向量模型（默认关闭；需要 OpenAI 兼容的 embedding 端点）
# DeepSeek 不提供 embedding，需另配 DashScope / SiliconFlow / 本地模型等
embedding.enabled=${EMBEDDING_ENABLED:false}
embedding.model=${EMBEDDING_MODEL:text-embedding-3-small}
embedding.dimensions=${EMBEDDING_DIMENSIONS:1024}
embedding.batch-size=50
embedding.backfill-delay-ms=60000
spring.ai.openai.chat.enabled=false
spring.ai.openai.embedding.enabled=${EMBEDDING_ENABLED:false}
spring.ai.openai.api-key=${EMBEDDING_API_KEY:}
spring.ai.openai.base-url=${EMBEDDING_BASE_URL:https://api.openai.com}
spring.ai.openai.embedding.options.model=${EMBEDDING_MODEL:text-embedding-3-small}
spring.ai.openai.embedding.options.dimensions=${EMBEDDING_DIMENSIONS:1024}

# 表演标签与按句切分（关闭后行为退化为纯文本 delta）
agent.performance.enabled=${PERFORMANCE_ENABLED:true}
agent.performance.max-speech-chars=120
agent.performance.min-speech-chars=12

# 语音合成（火山引擎豆包语音 HTTP Chunked 单向流式 V3）
# 入口是否开放看 tts.enabled；密钥未配置时 configured=false，合成返回 TTS_NOT_CONFIGURED
tts.enabled=${TTS_ENABLED:false}
tts.provider=volcengine
# 新版控制台 API Key 模式（推荐）；旧版控制台用 app-id + access-key
tts.volcengine.api-key=${VOLC_TTS_API_KEY:}
tts.volcengine.app-id=${VOLC_TTS_APP_ID:}
tts.volcengine.access-key=${VOLC_TTS_ACCESS_KEY:}
tts.volcengine.resource-id=${VOLC_TTS_RESOURCE_ID:seed-tts-2.0}
tts.volcengine.endpoint=${VOLC_TTS_ENDPOINT:https://openspeech.bytedance.com/api/v3/tts/unidirectional}
tts.volcengine.speaker=${VOLC_TTS_SPEAKER:zh_female_vv_uranus_bigtts}
tts.volcengine.model=${VOLC_TTS_MODEL:}
tts.volcengine.format=${VOLC_TTS_FORMAT:mp3}
tts.volcengine.sample-rate=${VOLC_TTS_SAMPLE_RATE:24000}
tts.volcengine.bit-rate=${VOLC_TTS_BIT_RATE:64000}
tts.volcengine.speech-rate=${VOLC_TTS_SPEECH_RATE:0}
tts.volcengine.loudness-rate=${VOLC_TTS_LOUDNESS_RATE:0}
tts.volcengine.connect-timeout-ms=5000
tts.volcengine.request-timeout-ms=15000
tts.volcengine.max-retries=1
tts.max-chars-per-request=300
tts.daily-char-quota=5000
tts.cache-ttl-seconds=604800
tts.max-audio-bytes=2097152

# 联网搜索（博查 Web Search API）
search.enabled=${SEARCH_ENABLED:true}
search.endpoint=${SEARCH_ENDPOINT:https://api.bochaai.com/v1/web-search}
search.api-key=${BOCHA_API_KEY:}
search.count=${SEARCH_COUNT:5}
search.timeout-ms=${SEARCH_TIMEOUT_MS:8000}
search.cache-ttl-seconds=${SEARCH_CACHE_TTL_SECONDS:300}

# Web Push VAPID（密钥通过环境变量注入）
# 上 HTTPS 前保持 WEBPUSH_ENABLED=false；VAPID 密钥不要更换，否则已有订阅全部失效
webpush.enabled=${WEBPUSH_ENABLED:false}
webpush.vapid.public-key=${WEB_PUSH_PUBLIC_KEY:}
webpush.vapid.private-key=${WEB_PUSH_PRIVATE_KEY:}
webpush.vapid.subject=${WEB_PUSH_SUBJECT:mailto:admin@example.com}
