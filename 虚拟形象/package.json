{
  "name": "avatar-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "像素风虚拟陪伴助手前端（Web / PWA / Electron）",
  "author": "likedragon91",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "vite build --mode desktop --base=./ --outDir=dist-electron",
    "electron:dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron electron/main.cjs --dev\"",
    "electron:build": "npm run build:desktop && electron-builder --config electron-builder.yml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.5",
    "marked": "^18.2.0",
    "pinia": "^3.0.4",
    "pixi.js": "^8.22.0",
    "sm-crypto": "^0.5.7",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  }
}
