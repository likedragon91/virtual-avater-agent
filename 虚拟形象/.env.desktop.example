# Electron 生产构建配置
# 复制为 .env.desktop 后填入真实地址：
#   cp .env.desktop.example .env.desktop
#
# file:// 下不能使用相对路径 /api，必须填写后端绝对地址。
# 尚未上 HTTPS 时：VITE_API_BASE_URL=http://<SERVER_IP>/api
# 已上 HTTPS 后：  VITE_API_BASE_URL=https://<域名>/api

VITE_API_BASE_URL=https://avatar.example.com/api
VITE_ASSET_BASE_URL=https://avatar.example.com
